{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist",
    "incremental": true
  },
  "include": ["src", "prisma", "prisma.config.ts", "vitest.config.mts"]
}
