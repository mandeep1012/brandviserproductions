# Runtime connection. On Vercel + Neon this is the *pooled* URL injected by the Marketplace integration.
DATABASE_URL="postgresql://bvp:bvp@localhost:5434/brandviserproductions"
# Direct (unpooled) URL used only by Prisma Migrate. Neon injects this as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://bvp:bvp@localhost:5434/brandviserproductions"
# Comma-separated browser origins allowed to call the API. One `*` per entry matches a hostname
# segment, e.g. https://brandviserproductions-web-*.vercel.app for previews.
CORS_ORIGINS="http://localhost:3000"
PORT=4000

# Enquiry notification email (Resend, from the Vercel Marketplace). Optional locally: without a
# key the email is logged instead of sent.
RESEND_API_KEY=""
ENQUIRY_NOTIFY_TO="events@example.com"
ENQUIRY_FROM="BRANDVISER Website <enquiries@example.com>"

# Vercel Blob read-write token, injected when a Blob store is connected to the project.
# Required for PDF brief uploads.
BLOB_READ_WRITE_TOKEN=""

# Bearer token for /api/v1/admin/*. Admin routes return 401 for every request while it is unset.
ADMIN_API_TOKEN=""

# On-demand revalidation of the web app after admin content writes.
WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="change-me"

# Cal.com / Calendly booking link returned after an enquiry and shown in the scheduler.
SCHEDULER_URL=""
