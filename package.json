{
  "name": "brandviserproductions",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @brandviserproductions/api\" \"npm run dev -w @brandviserproductions/web\"",
    "build": "npm run build -w @brandviserproductions/api && npm run build -w @brandviserproductions/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @brandviserproductions/api",
    "db:seed": "npm run db:seed -w @brandviserproductions/api",
    "db:studio": "npm run db:studio -w @brandviserproductions/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
